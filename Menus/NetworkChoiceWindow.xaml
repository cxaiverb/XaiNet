<Window x:Class="XaiNet2.Menus.NetworkChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose network"
        Width="390" Height="220"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helpers/Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border x:Name="BlurredBackground" Background="#55000000" CornerRadius="10"/>
        <Border CornerRadius="10" Background="#AA222222" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Name="TitleLabel"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1"
                           x:Name="MessageLabel"
                           Foreground="LightGray"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <ComboBox Grid.Row="2"
                          x:Name="ChoiceCombo"
                          Style="{StaticResource DarkComboBoxStyle}"
                          VerticalAlignment="Top"/>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Content="Cancel"
                            Style="{StaticResource CustomButton}"
                            Width="84"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"
                            IsCancel="True"/>
                    <Button Content="OK"
                            Style="{StaticResource PrimaryButton}"
                            Width="100"
                            IsDefault="True"
                            Click="OkButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
