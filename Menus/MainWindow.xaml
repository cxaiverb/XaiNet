<Window x:Class="XaiNet2.Menus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XaiNet2.Properties"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:XaiNet2.Helpers"
        Title="Networks"
        ShowInTaskbar="False"
        Width="350" Height="450"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helpers/Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <vm:BitsToHumanConverter x:Key="BitsToHumanConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border x:Name="BlurredBackground" Background="#55000000" CornerRadius="10"/>
        <Border CornerRadius="10" Background="#AA222222" Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: title fills, action buttons pinned right -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NetworkTextBlock" Text="Networks" Foreground="White" FontSize="16"
                               Grid.Column="0"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- OpenVPN Button -->
                        <Button x:Name="VPNButton" Width="32" Height="32"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="VPNButton_Click"
                                ToolTip="OpenVPN Menu"/>
                        <!-- Tailscale Button (icon is an inline 3x3 dot grid evoking the Tailscale logo) -->
                        <Button x:Name="TailscaleButton" Width="32" Height="32"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="TailscaleButton_Click"
                                ToolTip="Tailscale">
                            <Viewbox Width="16" Height="16">
                                <Grid Width="16" Height="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Row="0" Grid.Column="0" Fill="White" Opacity="0.35" Margin="1"/>
                                    <Ellipse Grid.Row="0" Grid.Column="1" Fill="White" Margin="1"/>
                                    <Ellipse Grid.Row="0" Grid.Column="2" Fill="White" Opacity="0.35" Margin="1"/>
                                    <Ellipse Grid.Row="1" Grid.Column="0" Fill="White" Margin="1"/>
                                    <Ellipse Grid.Row="1" Grid.Column="1" Fill="White" Margin="1"/>
                                    <Ellipse Grid.Row="1" Grid.Column="2" Fill="White" Margin="1"/>
                                    <Ellipse Grid.Row="2" Grid.Column="0" Fill="White" Opacity="0.35" Margin="1"/>
                                    <Ellipse Grid.Row="2" Grid.Column="1" Fill="White" Margin="1"/>
                                    <Ellipse Grid.Row="2" Grid.Column="2" Fill="White" Opacity="0.35" Margin="1"/>
                                </Grid>
                            </Viewbox>
                        </Button>
                        <!-- Wireless Networks Button -->
                        <Button x:Name="WifiButton" Width="32" Height="32"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="WifiButton_Click"
                                ToolTip="WiFi Menu"/>
                        <!-- Options Button -->
                        <Button x:Name="OptionsButton" Width="32" Height="32"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="OptionsButton_Click"
                                ToolTip="Options Menu"/>
                        <!-- Pin Button -->
                        <Button Name="PinButton" Width="32" Height="32"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="PinButton_Click"
                                ToolTip="Pins window to the top"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <ItemsControl Name="NetworkList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding NetName}" Foreground="White" FontSize="14" Margin="5"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Resources>
                                            <Style TargetType="Expander" BasedOn="{StaticResource ExpanderStyle1}"/>
                                        </Expander.Resources>
                                        <StackPanel Margin="10,0,0,0">
                                            <TabControl Background="Transparent" HorizontalAlignment="Center">
                                                <TabItem Header="Speed" Width="{Binding SpeedTab}">
                                                    <StackPanel>
                                                        <Grid HorizontalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding SentSpeed, Converter={StaticResource BitsToHumanConverter}, StringFormat={}Up: {0}/s}" Foreground="#00FF00" FontSize="14" Margin="5" Grid.Column="0" Grid.Row="0"/>
                                                            <TextBlock Text="{Binding ReceiveSpeed, Converter={StaticResource BitsToHumanConverter}, StringFormat={}Down: {0}/s}" Foreground="#00C8FF" FontSize="14" Margin="5" Grid.Column="1" Grid.Row="0"/>
                                                        </Grid>
                                                        <lvc:CartesianChart Series="{Binding Series}" Height="150" Margin="0,0,0,0"
                                                                    YAxes="{Binding YAxes}"
                                                                    XAxes="{Binding XAxes}"
                                                                    TooltipPosition="Top"
                                                                    TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
                                                                    TooltipTextPaint="{Binding TooltipTextPaint}"
                                                                    TooltipTextSize="14"
                                                                    FindingStrategy="CompareOnlyX"                                                                   
                                                                    />
                                                    </StackPanel>
                                                </TabItem>
                                                <TabItem Header="Details" Width="{Binding DetailsTab}">
                                                    <StackPanel Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Type}" Foreground="LightGray"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="LightGray"/>
                                                        <TextBlock Text="{Binding IPAddress}" Foreground="LightGray"/>
                                                        <TextBlock Text="{Binding Speed, Converter={StaticResource BitsToHumanConverter}, StringFormat={}{0}ps}" Foreground="LightGray"/>
                                                        <TextBlock Text="{Binding SentSpeed, Converter={StaticResource BitsToHumanConverter}, StringFormat={}{0}/s}" Foreground="LightGray"/>
                                                        <TextBlock Text="{Binding ReceiveSpeed, Converter={StaticResource BitsToHumanConverter}, StringFormat={}{0}/s}" Foreground="LightGray"/>
                                                    </StackPanel>
                                                </TabItem>
                                                <TabItem Header="Nerd Stats" Width="{Binding NerdTab}"
                                                         Visibility="{Binding NerdStatsVisible, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Description}" Foreground="LightGray" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Mac}" Foreground="LightGray"/>
                                                        <TextBlock Text="{Binding Gateway}" Foreground="LightGray"/>
                                                        <TextBlock Text="{Binding Dns}" Foreground="LightGray" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </TabItem>
                                            </TabControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
