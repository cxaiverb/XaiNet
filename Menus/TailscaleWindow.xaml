<Window x:Class="XaiNet2.Menus.TailscaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tailscale" Width="350" Height="400"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helpers/Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="#AA222222" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tailscale" Foreground="White" FontSize="16"
                           Grid.Column="0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="HomeButton" Width="32" Height="32"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="HomeButton_Click"
                            ToolTip="Home"/>
                    <Button x:Name="RefreshButton" Width="32" Height="32"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="RefreshButton_Click"
                            ToolTip="Refresh"/>
                    <Button x:Name="PinButton" Width="32" Height="32"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="PinButton_Click"
                            ToolTip="Pins window to the top"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>

                    <!-- Status card -->
                    <Border Background="#44000000" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StatusDot" Text="●" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusText" Text="Checking…" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="SelfText" Foreground="#9AA0A6" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Connection actions -->
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="ConnectButton" Content="Connect" Margin="0,0,5,5"
                                Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click"/>
                        <Button x:Name="DisconnectButton" Content="Disconnect" Margin="0,0,5,5"
                                Style="{StaticResource CustomButton}" Click="DisconnectButton_Click"/>
                        <Button x:Name="LogoutButton" Content="Log out" Margin="0,0,5,5"
                                Style="{StaticResource CustomButton}" Click="LogoutButton_Click"/>
                    </WrapPanel>

                    <!-- Exit node -->
                    <TextBlock Text="Exit node" Foreground="LightGray" FontSize="11" Margin="2,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ExitNodeCombo" Grid.Column="0"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  DisplayMemberPath="Label"/>
                        <Button x:Name="ApplyExitNodeButton" Grid.Column="1" Content="Apply"
                                Margin="8,0,0,0" Width="72"
                                Style="{StaticResource CustomButton}" Click="ApplyExitNodeButton_Click"/>
                    </Grid>

                    <!-- Inline message / error -->
                    <TextBlock x:Name="MessageText" Foreground="#F5C842" FontSize="11"
                               TextWrapping="Wrap" Margin="2,0,0,8" Visibility="Collapsed"/>

                    <!-- Devices -->
                    <TextBlock Text="Devices" Foreground="White" FontSize="14" Margin="0,2,0,4"/>
                    <TextBlock x:Name="NoDevicesText" Text="No devices to show."
                               Foreground="LightGray" FontSize="12" Margin="2,4" Visibility="Collapsed"/>
                    <ItemsControl x:Name="DevicesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2,3" Padding="8,6" Background="#44000000" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="●" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{Binding StatusBrush}"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Background="#332F7BF1" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsExitNode, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="exit node" Foreground="#7AA2FF" FontSize="10" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#9AA0A6" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
