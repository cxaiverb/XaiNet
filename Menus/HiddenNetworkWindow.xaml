<Window x:Class="XaiNet2.Menus.HiddenNetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add network"
        Width="400" Height="480"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helpers/Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border x:Name="BlurredBackground" Background="#55000000" CornerRadius="10"/>
        <Border CornerRadius="10" Background="#AA222222" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Section label -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="🔒"
                               FontSize="14"
                               Foreground="{StaticResource Accent.Lock}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Manually connect to a wireless network"
                               Foreground="LightGray"
                               Margin="8,0,0,0"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Description -->
                <TextBlock Grid.Row="1"
                           Text="Enter the network's details exactly as configured."
                           Foreground="#AAAAAA"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,4,0,12"/>

                <!-- SSID -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Network name"
                               Foreground="LightGray"
                               FontSize="11"
                               Margin="2,0,0,4"/>
                    <TextBox x:Name="SsidBox"
                             Style="{StaticResource DarkTextBoxStyle}"
                             MaxLength="32"/>
                </StackPanel>

                <!-- Security type -->
                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="Security type"
                               Foreground="LightGray"
                               FontSize="11"
                               Margin="2,0,0,4"/>
                    <ComboBox x:Name="SecurityCombo"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="SecurityCombo_SelectionChanged">
                        <ComboBoxItem Content="No authentication (Open)" Tag="Open"/>
                        <ComboBoxItem Content="WEP" Tag="Wep"/>
                        <ComboBoxItem Content="WPA2-Personal AES" Tag="Wpa2PersonalAes" IsSelected="True"/>
                        <ComboBoxItem Content="WPA2-Enterprise AES" Tag="Wpa2EnterpriseAes"/>
                        <ComboBoxItem Content="802.1X WEP" Tag="WepEnterprise"/>
                    </ComboBox>
                </StackPanel>

                <!-- Password row + reveal toggle (visible only for password-using types) -->
                <StackPanel Grid.Row="4"
                            x:Name="PasswordSection"
                            Margin="0,0,0,10">
                    <TextBlock x:Name="PasswordLabel"
                               Text="Security key"
                               Foreground="LightGray"
                               FontSize="11"
                               Margin="2,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="pwdBox"
                                         Style="{StaticResource DarkPasswordBoxStyle}"/>
                            <TextBox x:Name="pwdPlain"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <Button Grid.Column="1"
                                x:Name="ShowPasswordButton"
                                Content="Show"
                                Style="{StaticResource CustomButton}"
                                Click="ShowPasswordButton_Click"
                                Width="68"
                                Margin="8,0,0,0"
                                ToolTip="Reveal or hide password"/>
                    </Grid>
                    <TextBlock x:Name="CapsLockHint"
                               Text="⚠ Caps Lock is on"
                               Foreground="#F5C842"
                               FontSize="11"
                               Margin="2,6,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Connect automatically -->
                <CheckBox Grid.Row="5"
                          x:Name="AutoConnectCheckBox"
                          Content="Start this connection automatically"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          IsChecked="True"
                          Margin="2,2,0,8"/>

                <!-- Non-broadcast (hidden network) -->
                <CheckBox Grid.Row="6"
                          x:Name="NonBroadcastCheckBox"
                          Content="Connect even if this network is not broadcasting"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          IsChecked="True"
                          Margin="2,2,0,4"/>

                <!-- Action row -->
                <StackPanel Grid.Row="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource CustomButton}"
                            Width="84"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"
                            IsCancel="True"/>
                    <Button x:Name="ConnectButton"
                            Content="Connect"
                            Style="{StaticResource PrimaryButton}"
                            Width="100"
                            IsDefault="True"
                            Click="SubmitButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
