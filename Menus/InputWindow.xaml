<Window x:Class="XaiNet2.Menus.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Width="250" Height="100"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border CornerRadius="10" Background="#AA222222" Padding="10">
            <StackPanel>
                <TextBlock x:Name="SSIDLabel"  Text="{Binding SSID}" Foreground="White" Margin="0,0,0,5"/>
                    <PasswordBox Name="pwdBox" 
                             Width="200" 
                             Height="25" 
                             Background="White" 
                             Foreground="Black"/>
                    <Button Name="SubmitButton" 
                        Content="Submit" 
                        Width="75" 
                        Height="25" 
                        Margin="0,5,0,0"
                        Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
