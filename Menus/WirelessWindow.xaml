<Window x:Class="XaiNet2.WirelessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi-Fi" Width="350" Height="400"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helpers/Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border x:Name="BlurredBackground" Background="#55000000" CornerRadius="10"/>
        <Border CornerRadius="10" Background="#AA222222" Padding="10">
            <Grid>
                <Grid VerticalAlignment="Top"
                      HorizontalAlignment="Left"
                      ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title Block -->
                    <TextBlock Text="Wi-Fi Networks" Foreground="White"
                               FontSize="16"
                               Grid.Column="0"
                               Grid.Row="0"
                               VerticalAlignment="Center"
                               Margin="0,0,94,0"/>
                    <Button Name="HomeButton" Click="HomeButton_Click"
                            Width="32" Height="32"
                            ToolTip="Home"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Grid.Column="1"
                            Grid.Row="0"/>
                    <Button Name="RefreshButton" Click="RefreshWiFi_Click"
                            Width="32" Height="32"
                            ToolTip="Refresh"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Grid.Column="2"
                            Grid.Row="0"/>
                    <Button Name="ProfileButton" Click="ProfileButton_Click"
                            Width="32" Height="32"
                            ToolTip="Saved Profiles"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Grid.Column="3"
                            Grid.Row="0"/>
                    <Button Name="PinButton" Width="32" Height="32"
                            Background="Transparent" Foreground="White" 
                            BorderThickness="0" Cursor="Hand"
                            Click="PinButton_Click"
                            Grid.Column="4"
                            Grid.Row="0"
                            ToolTip="Pins window to the top"/>
                </Grid>
                <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Name="AvailableNetworks">
                        <StackPanel Name="AvailableNetworksPanel">
                            <TextBlock Text="No Wi-Fi adapter detected." Foreground="LightGray" Name="NoWiFiTextBlock"/>
                        </StackPanel>
                        <ItemsControl Name="WiFiNetworkList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ShowGridLines="True" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding SSID}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   Margin="5"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SignalStrength}"
                                                   Foreground="LightGray"
                                                   FontSize="12"
                                                   Margin="5"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="Connect"
                                                Click="ConnectToWiFi_Click"
                                                Tag="{Binding SSID}"
                                                Foreground="White"
                                                HorizontalAlignment="Right"
                                                Width="80"
                                                Margin="5,2,0,0"
                                                Grid.Column="2"
                                                Style="{StaticResource CustomButton}"/>

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
