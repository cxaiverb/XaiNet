<Window x:Class="XaiNet2.Menus.VPNWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN" Width="350" Height="400"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helpers/Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="#AA222222" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: title fills, nav buttons pinned right -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="OpenVPN" Foreground="White" FontSize="16"
                           Grid.Column="0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="HomeButton" Width="32" Height="32"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="HomeButton_Click"
                            ToolTip="Home"/>
                    <Button x:Name="SettingsButton" Width="32" Height="32"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="SettingsButton_Click"
                            ToolTip="Options"/>
                    <Button x:Name="PinButton" Width="32" Height="32"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="PinButton_Click"
                            ToolTip="Pins window to the top"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>
                    <Button Content="+ Add profile…"
                            Style="{StaticResource CustomButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"
                            Margin="2,0,2,8"
                            Click="AddProfileButton_Click"
                            ToolTip="Import an OpenVPN .ovpn config file"/>
                    <TextBlock Text="No VPN profiles yet. Use “+ Add profile…” to import an .ovpn file."
                               Foreground="LightGray" FontSize="12" TextWrapping="Wrap" Margin="2,4"
                               Visibility="Collapsed"
                               x:Name="NoVpnProfilesTextBlock"/>
                    <ItemsControl x:Name="VpnProfilesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2,3" Padding="10,8" Background="#44000000" CornerRadius="8">
                                    <StackPanel>
                                        <!-- Title row: name + connection badge -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1"
                                                    Background="#3334D399"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="● Connected"
                                                           Foreground="{StaticResource Accent.Connected}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding AutoConnectText}"
                                                   Foreground="#9AA0A6" FontSize="11"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding HasAutoConnect, Converter={StaticResource BoolToVis}}"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Connect" Margin="0,0,6,6" Style="{StaticResource PrimaryButton}"
                                                    Click="ConnectButton_Click" ToolTip="Connect this VPN"/>
                                            <Button Content="Disconnect" Margin="0,0,6,6" Style="{StaticResource CustomButton}"
                                                    Click="DisconnectButton_Click" ToolTip="Disconnect this VPN"/>
                                            <Button Content="Auto" Margin="0,0,6,6" Style="{StaticResource CustomButton}"
                                                    Click="AutoButton_Click" ToolTip="Auto-connect when joining a chosen Wi-Fi network"/>
                                            <Button Content="Log" Margin="0,0,6,6" Style="{StaticResource CustomButton}"
                                                    Click="LogButton_Click" ToolTip="Open this profile's log file"/>
                                            <Button Content="Delete" Margin="0,0,6,6" Style="{StaticResource CustomButton}"
                                                    Click="DeleteButton_Click" ToolTip="Remove this profile"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>

</Window>