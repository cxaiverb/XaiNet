<Window x:Class="XaiNet2.Menus.WirelessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi-Fi" Width="350" Height="400"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helpers/Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border x:Name="BlurredBackground" Background="#55000000" CornerRadius="10"/>
        <Border CornerRadius="10" Background="#AA222222" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Header: title fills, action buttons pinned right -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wi-Fi Networks" Foreground="White"
                               FontSize="16"
                               Grid.Column="0"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="ToggleButton" Click="ToggleButton_Click"
                                Width="32" Height="32"
                                ToolTip="Turn Wi-Fi on or off"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Cursor="Hand"/>
                        <Button Name="HomeButton" Click="HomeButton_Click"
                                Width="32" Height="32"
                                ToolTip="Back to networks"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Cursor="Hand"/>
                        <Button Name="RefreshButton" Click="RefreshWiFi_Click"
                                Width="32" Height="32"
                                ToolTip="Re-scan for networks"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Cursor="Hand"/>
                        <Button Name="ProfileButton" Click="ProfileButton_Click"
                                Width="32" Height="32"
                                ToolTip="Saved profiles"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Cursor="Hand"/>
                        <Button Name="PinButton" Width="32" Height="32"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="PinButton_Click"
                                ToolTip="Pins window to the top"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Name="AvailableNetworks">
                        <StackPanel Name="AvailableNetworksPanel">
                            <TextBlock Text="No Wi-Fi adapter detected."
                                       Foreground="LightGray"
                                       Name="NoWiFiTextBlock"
                                       Margin="5,8"
                                       Visibility="Collapsed"/>
                            <TextBlock Text="Wi-Fi is turned off."
                                       Foreground="LightGray"
                                       Name="WiFiDisabledTextBlock"
                                       Margin="5,8"
                                       Visibility="Collapsed"/>
                            <TextBlock Text="No networks found. Try refreshing."
                                       Foreground="LightGray"
                                       Name="NoNetworksTextBlock"
                                       Margin="5,8"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        <Button x:Name="HiddenNetworkButton"
                                Click="HiddenNetworkButton_Click"
                                Style="{StaticResource CustomButton}"
                                Content="+ Add network manually…"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,8"
                                Margin="2,8,2,4"
                                ToolTip="Add a wireless network by name (hidden, WEP, Enterprise, etc.)"/>
                        <ItemsControl Name="WiFiNetworkList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2,3" Padding="8,6" CornerRadius="6" Background="#44000000">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Signal strength -->
                                            <TextBlock Text="{Binding SignalStrength}"
                                                       Foreground="LightGray"
                                                       FontSize="12"
                                                       Grid.Column="0"
                                                       VerticalAlignment="Center"/>

                                            <!-- Lock icon -->
                                            <TextBlock Text="🔒"
                                                       FontSize="12"
                                                       Foreground="{StaticResource Accent.Lock}"
                                                       Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       ToolTip="Secured network"
                                                       Visibility="{Binding IsSecured, Converter={StaticResource BoolToVis}}"/>

                                            <!-- SSID -->
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Action area: Connect button when disconnected,
                                                 "Connected" + Disconnect when connected -->
                                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                                <Button Content="Connect"
                                                        Click="ConnectToWiFi_Click"
                                                        Tag="{Binding SSID}"
                                                        HorizontalAlignment="Right"
                                                        Width="84">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CustomButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="● Connected"
                                                               Foreground="{StaticResource Accent.Connected}"
                                                               FontSize="12"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="Disconnect"
                                                            Click="DisconnectButton_Click"
                                                            Tag="{Binding SSID}"
                                                            Width="92"
                                                            Style="{StaticResource CustomButton}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
